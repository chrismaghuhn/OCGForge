{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev-windows",
      "displayName": "M0 Windows native development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "M0_AUTO_FETCH_RULES": "ON"
      }
    },
    {
      "name": "release-windows",
      "displayName": "M0 Windows native release verification",
      "inherits": "dev-windows",
      "binaryDir": "${sourceDir}/build/release-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev-windows-zig",
      "displayName": "M0 Windows local Zig fallback",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-zig",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.cache/toolchain/ninja/ninja.exe",
        "M0_AUTO_FETCH_RULES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-windows",
      "configurePreset": "dev-windows"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows"
    },
    {
      "name": "dev-windows-zig",
      "configurePreset": "dev-windows-zig"
    }
  ],
  "testPresets": [
    {
      "name": "dev-windows",
      "configurePreset": "dev-windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-windows-zig",
      "configurePreset": "dev-windows-zig",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
