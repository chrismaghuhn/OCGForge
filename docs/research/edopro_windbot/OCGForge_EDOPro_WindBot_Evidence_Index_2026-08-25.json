  "key_findings": [
    {
      "severity": "MAJOR",
      "id": "protocol-long-tail",
      "fact": "OCGForge live decoder supports many interactive families but explicitly fails closed on MSG_ANNOUNCE_CARD, MSG_ROCK_PAPER_SCISSORS and MSG_REQUEST_DECK.",
      "recommendation": "Prioritize differential protocol fixtures, especially MSG_ANNOUNCE_CARD and combinatorial families."
    },
    {
      "severity": "MAJOR",
      "id": "windbot-interface-mismatch",
      "fact": "WindBot uses mutable Duel/ClientField/ClientCard state, ordered executors and queued selection callbacks; Program and Executor instantiate Random without an explicit OCGForge seed contract.",
      "recommendation": "Adapt semantic heuristic ideas to PlayerObservation + ActionCandidate rather than porting the state model."
    },
    {
      "severity": "MAJOR",
      "id": "replay-provenance",
      "fact": "EDOPro replay records seed/configuration/responses or a packet stream, but does not encode the complete OCGForge rules-bundle and schema provenance required for deterministic historical reproduction.",
      "recommendation": "Use YRP/YRPX only as design reference/import evidence for a future OCGForge replay ADR."
    }
  ],
  "primary_one_week_recommendation": {
    "activity": "Build a pinned differential interactive decision-protocol corpus and completeness ledger.",
    "comparison": [
      "pinned ocgcore behavior",
      "EDOPro interpretation/response encoding",
      "OCGForge semantic decision/response encoding"
    ],
